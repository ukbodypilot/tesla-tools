{
 "uid": "tesla",
 "title": "Tesla",
 "tags": [
  "tesla"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "gauge",
   "title": "Battery",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_battery_level",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 20
       },
       {
        "color": "green",
        "value": 40
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Range",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_range_miles",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "lengthmi",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Locked",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 3,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_locked",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "UNLOCKED",
         "color": "red"
        },
        "1": {
         "text": "Locked",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Car is",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 11,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (mode) (tesla_mode) == 1",
     "refId": "A",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "name",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Odometer",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 3,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_odometer",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "lengthmi",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Last car read",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 3,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(time() - tesla_last_read_timestamp_seconds)",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Est. Tesla spend this month (credit covers $10)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 21,
    "y": 0,
    "w": 3,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_spend_month_dollars",
     "refId": "A",
     "legendFormat": "spent"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_monthly_budget_dollars",
     "refId": "B",
     "legendFormat": "stop at"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "unit": "currencyUSD",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Battery % and charge limit",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_battery_level",
     "refId": "A",
     "legendFormat": "battery"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_charge_limit_soc",
     "refId": "B",
     "legendFormat": "limit"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "fillOpacity": 10
     },
     "min": 0,
     "max": 100
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Awake or asleep (1 = awake)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_online",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "fillOpacity": 10
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Charging power",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_charger_power",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatt",
     "custom": {
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Tyre pressures",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_tpms_bar",
     "refId": "A",
     "legendFormat": "{{wheel}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "pressurebar",
     "custom": {
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Temperatures",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_inside_temp",
     "refId": "A",
     "legendFormat": "inside"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "tesla_outside_temp",
     "refId": "B",
     "legendFormat": "outside"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "custom": {
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Tesla API requests (by endpoint)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (endpoint, code) (increase(tesla_api_requests_total[1h]))",
     "refId": "A",
     "legendFormat": "{{endpoint}} {{code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "stepAfter",
      "spanNulls": true,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  }
 ],
 "links": [
  {
   "title": "Charging sessions",
   "type": "link",
   "url": "http://localhost:9877/#charging",
   "targetBlank": true,
   "icon": "bolt"
  }
 ]
}